@inject IJSRuntime JS

<div class="loc-row">
    <span class="loc-label">📍 Location</span>
    <div class="loc-fields">
        <input type="number" step="any" placeholder="Latitude"
               value="@Lat" @onchange="OnLatChange" />
        <input type="number" step="any" placeholder="Longitude"
               value="@Lon" @onchange="OnLonChange" />
        <button type="button" class="geo-btn" @onclick="GetGeo">Use GPS</button>
    </div>
    @if (Err != null) { <p class="geo-err">@Err</p> }
</div>

@code {
    [Parameter] public double? Lat { get; set; }
    [Parameter] public EventCallback<double?> LatChanged { get; set; }
    [Parameter] public double? Lon { get; set; }
    [Parameter] public EventCallback<double?> LonChanged { get; set; }
    string? Err;

    async Task OnLatChange(ChangeEventArgs e) =>
        await LatChanged.InvokeAsync(e.Value == null ? null : double.TryParse(e.Value.ToString(), out var v) ? v : null);
    async Task OnLonChange(ChangeEventArgs e) =>
        await LonChanged.InvokeAsync(e.Value == null ? null : double.TryParse(e.Value.ToString(), out var v) ? v : null);

    async Task GetGeo()
    {
        Err = null;
        try
        {
            var c = await JS.InvokeAsync<double[]>("getLocation");
            if (c?.Length >= 2) { await LatChanged.InvokeAsync(c[0]); await LonChanged.InvokeAsync(c[1]); }
        }
        catch { Err = "GPS unavailable — enter coordinates manually."; }
    }
}

<style>
    .loc-row { margin-top:1rem; padding:0.7rem; background:#f9f9f9;
        border-radius:10px; border:1px solid #e5e5ea; }
    .loc-label { font-size:0.78rem; font-weight:700; color:#636366; display:block; margin-bottom:0.4rem; }
    .loc-fields { display:flex; gap:0.5rem; flex-wrap:wrap; }
    .loc-fields input { flex:1; min-width:100px; border:1px solid #d1d1d6;
        border-radius:8px; padding:0.45rem 0.6rem; font-size:0.88rem; }
    .geo-btn { background:none; border:1px solid #0a84ff; color:#0a84ff;
        border-radius:8px; padding:0.45rem 0.8rem; font-size:0.8rem; cursor:pointer; white-space:nowrap; }
    .geo-err { color:#ff3b30; font-size:0.78rem; margin:0.3rem 0 0; }
</style>
