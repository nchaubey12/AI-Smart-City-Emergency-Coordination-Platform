@if (!string.IsNullOrEmpty(Msg))
{
    <div class="msg-banner @(IsSuccess ? "success" : "error")">
        @(IsSuccess ? "✅" : "⚠️") @Msg
    </div>
}

@code {
    [Parameter] public string?  Msg       { get; set; }
    [Parameter] public bool     IsSuccess { get; set; }
}

<style>
    .msg-banner { border-radius:10px; padding:0.65rem 1rem; font-size:0.86rem; font-weight:600; }
    .msg-banner.error   { background:rgba(255,45,85,0.12);  color:#ff6b8a; border:1px solid rgba(255,45,85,0.25); }
    .msg-banner.success { background:rgba(48,209,88,0.12);  color:#34c759; border:1px solid rgba(48,209,88,0.25); }
</style>
