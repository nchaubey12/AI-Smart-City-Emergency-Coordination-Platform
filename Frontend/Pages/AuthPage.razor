@page "/login"
@page "/register"
@using EmergencyPlatform.Frontend.Models
@using EmergencyPlatform.Frontend.Services
@inject AuthService Auth
@inject NavigationManager Nav

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-logo">
            <div class="logo-circle">🚨</div>
            <h1 class="auth-title">ECP</h1>
            <p class="auth-subtitle">Smart City Coordination Platform</p>
        </div>

        <div class="auth-tabs">
            <button class="auth-tab @(Mode == "login" ? "active" : "")"
                    @onclick='() => SwitchMode("login")'>Login</button>
            <button class="auth-tab @(Mode == "register" ? "active" : "")"
                    @onclick='() => SwitchMode("register")'>Register</button>
        </div>

        <!-- ── LOGIN ──────────────────────────────────────────────────── -->
        @if (Mode == "login")
        {
            <div class="auth-form">
                <div class="field-group">
                    <label>Email Address</label>
                    <div class="input-wrap">
                        <span class="input-icon">✉️</span>
                        <input type="email" placeholder="your@email.com"
                               @bind="LoginEmail" @bind:event="oninput" />
                    </div>
                </div>
                <div class="field-group">
                    <label>Password</label>
                    <div class="input-wrap">
                        <span class="input-icon">🔒</span>
                        <input type="@(ShowPw ? "text" : "password")"
                               placeholder="Enter password"
                               @bind="LoginPassword" @bind:event="oninput" />
                        <button class="toggle-pw" @onclick="() => ShowPw = !ShowPw">
                            @(ShowPw ? "🙈" : "👁")
                        </button>
                    </div>
                </div>

                <MessageBanner Msg="@Message" IsSuccess="@IsSuccess" />

                <button class="auth-btn" @onclick="DoLogin" disabled="@IsLoading">
                    @if (IsLoading) { <span class="spinner"></span> } Login
                </button>
                <p class="switch-hint">No account? <a @onclick='() => SwitchMode("register")'>Register here</a></p>
            </div>
        }

        <!-- ── REGISTER ───────────────────────────────────────────────── -->
        @if (Mode == "register")
        {
            <div class="auth-form">
                <div class="field-group">
                    <label>Full Name</label>
                    <div class="input-wrap">
                        <span class="input-icon">👤</span>
                        <input type="text" placeholder="Your full name"
                               @bind="RegName" @bind:event="oninput" />
                    </div>
                </div>
                <div class="field-group">
                    <label>Email Address</label>
                    <div class="input-wrap">
                        <span class="input-icon">✉️</span>
                        <input type="email" placeholder="your@email.com"
                               @bind="RegEmail" @bind:event="oninput" />
                    </div>
                </div>
                <div class="field-group">
                    <label>Phone Number</label>
                    <div class="input-wrap">
                        <span class="input-icon">📱</span>
                        <input type="tel" placeholder="Your phone number"
                               @bind="RegPhone" @bind:event="oninput" />
                    </div>
                </div>
                <div class="field-group">
                    <label>Password</label>
                    <div class="input-wrap">
                        <span class="input-icon">🔒</span>
                        <input type="@(ShowPw ? "text" : "password")"
                               placeholder="Min 6 characters"
                               @bind="RegPassword" @bind:event="oninput" />
                        <button class="toggle-pw" @onclick="() => ShowPw = !ShowPw">
                            @(ShowPw ? "🙈" : "👁")
                        </button>
                    </div>
                </div>
                <div class="field-group">
                    <label>Confirm Password</label>
                    <div class="input-wrap">
                        <span class="input-icon">🔒</span>
                        <input type="password" placeholder="Repeat password"
                               @bind="RegConfirm" @bind:event="oninput" />
                    </div>
                </div>

                <MessageBanner Msg="@Message" IsSuccess="@IsSuccess" />

                <button class="auth-btn" @onclick="DoRegister" disabled="@IsLoading">
                    @if (IsLoading) { <span class="spinner"></span> } Create Account
                </button>
                <p class="switch-hint">Already registered? <a @onclick='() => SwitchMode("login")'>Login</a></p>
            </div>
        }

        <div class="demo-hint">
            New users are registered as <strong>User</strong> role.<br/>
            Contact your administrator to get Admin access.
        </div>

    </div>
</div>

@code {
    string Mode = "login";
    string LoginEmail = "", LoginPassword = "";
    string RegName = "", RegEmail = "", RegPhone = "", RegPassword = "", RegConfirm = "";
    bool ShowPw, IsLoading, IsSuccess;
    string? Message;

    protected override void OnInitialized()
    {
         if (Auth.IsLoggedIn) Nav.NavigateTo(Auth.IsAdmin ? "/dashboard" : "/report");
        Mode = Nav.Uri.Contains("register") ? "register" : "login";
    }

    void SwitchMode(string m) { Mode = m; Message = null; }

    async Task DoLogin()
    {
        if (string.IsNullOrWhiteSpace(LoginEmail) || string.IsNullOrWhiteSpace(LoginPassword))
        { Message = "Please fill in all fields."; IsSuccess = false; return; }

        IsLoading = true; Message = null;
        var result = await Auth.LoginAsync(new LoginRequest
        {
            Email    = LoginEmail,
            Password = LoginPassword
        });
        Message = result.Message; IsSuccess = result.Success; IsLoading = false;
        if (result.Success) { await Task.Delay(500); Nav.NavigateTo(Auth.IsAdmin ? "/dashboard" : "/report"); }
    }

    async Task DoRegister()
    {
        if (string.IsNullOrWhiteSpace(RegName) || string.IsNullOrWhiteSpace(RegEmail) ||
            string.IsNullOrWhiteSpace(RegPassword))
        { Message = "Please fill in all fields."; IsSuccess = false; return; }

        if (RegPassword != RegConfirm)
        { Message = "Passwords do not match."; IsSuccess = false; return; }

        IsLoading = true; Message = null;
        var result = await Auth.RegisterAsync(new RegisterRequest
        {
            Name     = RegName,
            Email    = RegEmail,
            Phone    = RegPhone,
            Password = RegPassword,
            Role     = "User",    
            AdminKey = ""
        });
        Message = result.Message; IsSuccess = result.Success; IsLoading = false;
        if (result.Success) { await Task.Delay(1000); SwitchMode("login"); }
    }
}

<style>
    .auth-wrapper { min-height:100vh; background:linear-gradient(135deg,#0f0f1a,#1a1a2e,#0d1b2a);
        display:flex; align-items:center; justify-content:center; padding:1rem;
        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; }
    .auth-card { background:rgba(255,255,255,0.04); backdrop-filter:blur(20px);
        border:1px solid rgba(255,255,255,0.1); border-radius:24px;
        padding:2.5rem 2rem; width:100%; max-width:440px;
        box-shadow:0 25px 60px rgba(0,0,0,0.5); }
    .auth-logo { text-align:center; margin-bottom:1.8rem; }
    .logo-circle { width:64px; height:64px; background:linear-gradient(135deg,#ff2d55,#ff6b35);
        border-radius:50%; display:flex; align-items:center; justify-content:center;
        font-size:1.8rem; margin:0 auto 0.8rem; box-shadow:0 8px 24px rgba(255,45,85,0.4); }
    .auth-title { color:white; font-size:1.5rem; font-weight:900; margin:0; }
    .auth-subtitle { color:#8e8e93; font-size:0.82rem; margin:0.2rem 0 0; }
    .auth-tabs { display:flex; gap:0.4rem; background:rgba(255,255,255,0.05);
        border-radius:12px; padding:0.3rem; margin-bottom:1.5rem; }
    .auth-tab { flex:1; padding:0.55rem; border:none; border-radius:9px;
        background:transparent; color:#8e8e93; font-size:0.9rem; font-weight:600; cursor:pointer; }
    .auth-tab.active { background:rgba(255,255,255,0.12); color:white; }
    .auth-form { display:flex; flex-direction:column; gap:0.9rem; }
    .field-group { display:flex; flex-direction:column; gap:0.3rem; }
    .field-group label { color:#aeaeb2; font-size:0.78rem; font-weight:600; }
    .input-wrap { display:flex; align-items:center; background:rgba(255,255,255,0.07);
        border:1px solid rgba(255,255,255,0.12); border-radius:11px; overflow:hidden; }
    .input-wrap:focus-within { border-color:#0a84ff; }
    .input-icon { padding:0 0.7rem; font-size:0.95rem; }
    .input-wrap input { flex:1; background:transparent; border:none; color:white;
        font-size:0.92rem; padding:0.7rem 0.4rem 0.7rem 0; outline:none; }
    .input-wrap input::placeholder { color:#48484a; }
    .toggle-pw { background:none; border:none; cursor:pointer; padding:0 0.7rem; font-size:0.95rem; }
    .auth-btn { width:100%; padding:0.85rem; background:linear-gradient(135deg,#0a84ff,#0066cc);
        color:white; border:none; border-radius:12px; font-size:0.95rem; font-weight:700;
        cursor:pointer; display:flex; align-items:center; justify-content:center; gap:0.5rem;
        margin-top:0.3rem; box-shadow:0 4px 16px rgba(10,132,255,0.35); }
    .auth-btn:disabled { opacity:0.5; cursor:not-allowed; }
    .spinner { width:16px; height:16px; border:2.5px solid rgba(255,255,255,0.3);
        border-top-color:white; border-radius:50%; animation:spin 0.7s linear infinite; }
    @@keyframes spin { to { transform:rotate(360deg); } }
    .switch-hint { text-align:center; color:#636366; font-size:0.82rem; margin:0.3rem 0 0; }
    .switch-hint a { color:#0a84ff; cursor:pointer; font-weight:600; }
    .demo-hint { margin-top:1.5rem; background:rgba(255,214,10,0.08);
        border:1px solid rgba(255,214,10,0.2); border-radius:10px;
        padding:0.7rem 1rem; font-size:0.75rem; color:#ffd60a; text-align:center; line-height:1.7; }
</style>
