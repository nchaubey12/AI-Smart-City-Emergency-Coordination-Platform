@page "/"
@page "/dashboard"
@using EmergencyPlatform.Frontend.Models
@using EmergencyPlatform.Frontend.Services
@inject AuthService Auth
@inject ReportApiService ReportApi
@inject NavigationManager Nav

<PageTitle>Admin Dashboard — EmergencyAI</PageTitle>

@if (!Auth.IsLoggedIn)
{
    <p>Redirecting...</p>
}
else if (!Auth.IsAdmin)
{
    <div class="no-access">
        <span style="font-size:3rem">🚫</span>
        <h2>Access Denied</h2>
        <p>This page is for administrators only.</p>
        <button class="btn-primary" @onclick='() => Nav.NavigateTo("/report")'>Go to Report Page</button>
    </div>
}
else
{
<div class="dashboard">
    <!-- ── Sidebar ─────────────────────────────────────────────────────────── -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">🚨</div>
            <div>
                <div class="brand-name">EmergencyAI</div>
                <div class="brand-role">Admin Console</div>
            </div>
        </div>
        <nav class="sidenav">
            <a class="navlink active" href="/dashboard">📊 Dashboard</a>
            <a class="navlink" href="/report">📝 New Report</a>
        </nav>
        <div class="sidebar-bottom">
            <div class="user-chip">
                <div class="avatar">@(Auth.CurrentUser!.Name[0])</div>
                <div>
                    <div class="uname">@Auth.CurrentUser.Name</div>
                    <div class="urole">Administrator</div>
                </div>
            </div>
            <button class="logout-btn" @onclick="Logout">🚪 Logout</button>
        </div>
    </aside>

    <!-- ── Main ───────────────────────────────────────────────────────────── -->
    <main class="main-area">
        <div class="topbar">
            <div>
                <h2 class="page-title">Live Incident Dashboard</h2>
                <p class="page-sub">All incidents aggregated from citizen reports</p>
            </div>
            <div class="topbar-actions">
                <button class="refresh-btn" @onclick="LoadIncidents" disabled="@IsLoading">
                    @(IsLoading ? "⏳" : "🔄") Refresh
                </button>
                <button class="btn-primary" @onclick='() => Nav.NavigateTo("/report")'>
                    + New Report
                </button>
            </div>
        </div>

        <!-- ── KPI Cards ───────────────────────────────────────────────────── -->
        <div class="kpi-grid">
            <div class="kpi-card" style="--accent:#ff2d55">
                <div class="kpi-val">@Incidents.Count(i => i.SeverityLevel == "critical")</div>
                <div class="kpi-lbl">Critical</div>
            </div>
            <div class="kpi-card" style="--accent:#ff9500">
                <div class="kpi-val">@Incidents.Count(i => i.SeverityLevel == "high")</div>
                <div class="kpi-lbl">High</div>
            </div>
            <div class="kpi-card" style="--accent:#ffd60a">
                <div class="kpi-val">@Incidents.Count(i => i.SeverityLevel == "medium")</div>
                <div class="kpi-lbl">Medium</div>
            </div>
            <div class="kpi-card" style="--accent:#30d158">
                <div class="kpi-val">@Incidents.Count(i => i.SeverityLevel == "low")</div>
                <div class="kpi-lbl">Low</div>
            </div>
            <div class="kpi-card" style="--accent:#0a84ff">
                <div class="kpi-val">@Incidents.Sum(i => i.ReportCount)</div>
                <div class="kpi-lbl">Total Reports</div>
            </div>
        </div>

        <!-- ── Incidents Table ─────────────────────────────────────────────── -->
        <div class="table-card">
            <div class="table-header">
                <h3>All Incidents</h3>
                <span class="live-dot">● LIVE</span>
            </div>

            @if (IsLoading)
            {
                <div class="loading-state">⏳ Loading incidents...</div>
            }
            else if (Incidents.Count == 0)
            {
                <div class="empty-state">
                    <span style="font-size:3rem">📡</span>
                    <p>No incidents yet. Submit a report to see data here.</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="inc-table">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Severity</th>
                                <th>Location</th>
                                <th>Description (first report)</th>
                                <th>Dispatch</th>
                                <th>Priority</th>
                                <th>Last Reported</th>
                                <th>Report Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inc in Incidents.OrderByDescending(i => i.LastReportedAt))
                            {
                                <tr class="inc-row">
                                    <td><span class="type-badge">@inc.IncidentIcon @inc.IncidentType</span></td>
                                    <td>
                                        <span class="sev-badge" style="background:@inc.SeverityColor20; color:@inc.SeverityColor; border:1px solid @inc.SeverityColor">
                                            @inc.SeverityLevel.ToUpper()
                                        </span>
                                    </td>
                                    <td class="loc-cell">📍 @inc.Location</td>
                                    <td class="desc-cell">—</td>
                                    <td class="dispatch-cell">@string.Join(", ", inc.DispatchUnits)</td>
                                    <td><span class="priority-tag">P@(inc.Priority)</span></td>
                                    <td class="time-cell">@inc.LastReportedAt.ToString("MMM d, HH:mm")</td>
                                    <td>
                                        <button class="count-btn"
                                                @onclick="() => OpenDetail(inc.IncidentKey)">
                                            @inc.ReportCount report@(inc.ReportCount != 1 ? "s" : "")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>
</div>

<!-- ── Detail Drawer ──────────────────────────────────────────────────────── -->
@if (DetailOpen && Detail != null)
{
    <div class="drawer-backdrop" @onclick="CloseDetail">
        <div class="drawer" @onclick:stopPropagation="true">
            <div class="drawer-header">
                <div>
                    <h3>@Detail.IncidentIcon @Detail.IncidentType.ToUpper() — All Reports</h3>
                    <p class="drawer-sub">📍 @Detail.Location · @Detail.ReportCount report(s)</p>
                </div>
                <button class="close-x" @onclick="CloseDetail">✕</button>
            </div>

            <div class="report-list">
                @foreach (var r in Detail.Reports.OrderByDescending(r => r.SubmittedAt))
                {
                    <div class="report-card">
                        <div class="rc-header">
                            <div class="rc-user">
                                <div class="rc-avatar">@(r.UserName.Length > 0 ? r.UserName[0] : '?')</div>
                                <div>
                                    <div class="rc-name">@r.UserName</div>
                                    <div class="rc-email">@r.UserEmail · @r.UserRole</div>
                                </div>
                            </div>
                            <div class="rc-time">@r.SubmittedAt.ToString("MMM d, HH:mm:ss")</div>
                        </div>
                        <div class="rc-body">
                            <span class="rc-type-tag">@r.InputType</span>
                            <p class="rc-desc">@(string.IsNullOrEmpty(r.Description) ? "(No text description)" : r.Description)</p>
                            @if (!string.IsNullOrEmpty(r.Location))
                            {
                                <p class="rc-loc">📍 @r.Location</p>
                            }
                        </div>
                        <div class="rc-id">Report ID: @r.ReportId</div>
                    </div>
                }
            </div>
        </div>
    </div>
}
}

@code {
    List<AggregatedIncidentSummary> Incidents = new();
    AggregatedIncidentDetail? Detail;
    bool IsLoading, DetailOpen;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        if (!Auth.IsAdmin) return;
        await LoadIncidents();
    }

    async Task LoadIncidents()
    {
        IsLoading = true;
        Incidents = await ReportApi.GetIncidentsAsync("Admin");
        IsLoading = false;
    }

    async Task OpenDetail(string key)
    {
        Detail = await ReportApi.GetIncidentDetailAsync(key, "Admin");
        DetailOpen = Detail != null;
    }

    void CloseDetail() { DetailOpen = false; Detail = null; }

    void Logout() { Auth.Logout(); Nav.NavigateTo("/login"); }
}

