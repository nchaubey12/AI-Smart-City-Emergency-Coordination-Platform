@page "/"
@page "/dashboard"
@using EmergencyPlatform.Frontend.Models
@using EmergencyPlatform.Frontend.Services
@inject AuthService Auth
@inject ReportApiService ReportApi
@inject NavigationManager Nav

<PageTitle>ECP Dashboard</PageTitle>

@if (!Auth.IsLoggedIn) { <p>Redirecting…</p> }
else if (!Auth.IsAdmin)
{
    <div class="no-access">
        <span style="font-size:2rem">⛔</span>
        <h2>Access Denied</h2>
        <p>This page is for administrators only.</p>
        <button class="btn-primary" @onclick='() => Nav.NavigateTo("/report")'>Go to Report Page</button>
    </div>
}
else
{
<div class="dashboard @(IsDark ? "theme-dark" : "theme-light")">

    <!-- ── Sidebar ───────────────────────────────────────────────────── -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">🚨</div>
            <div>
                <div class="brand-name">ECP</div>
                <div class="brand-role" Style = "margin-top: 0.5rem;">Admin Console</div>
            </div>
        </div>
        <nav class="sidenav">
            <a class="navlink active" href="/dashboard">Dashboard</a>
            <a class="navlink" href="/report">New Report</a>
        </nav>
        <div class="sidebar-bottom">
            <div class="user-chip">
                <div class="avatar">@(Auth.CurrentUser!.Name[0])</div>
                <div>
                    <div class="uname">@Auth.CurrentUser.Name</div>
                    <div class="urole">Administrator</div>
                </div>
            </div>
            <button class="theme-btn" @onclick="ToggleTheme">
                @(IsDark ? "☀️ Light Mode" : "🌙 Dark Mode")
            </button>
            <button class="logout-btn" @onclick="Logout">Logout</button>
        </div>
    </aside>

    <!-- ── Main ──────────────────────────────────────────────────────── -->
    <main class="main-area">
        <div class="topbar">
            <div>
                <h2 class="page-title">Incident Dashboard</h2>
                <p class="page-sub">Review · Override · Confirm to dispatch · Resolve when complete</p>
            </div>
            <div class="topbar-actions">
                <span class="topbar-time">@CurrentTime</span>
                <button class="refresh-btn" @onclick="LoadAll" disabled="@IsLoading">
                    @(IsLoading ? "Loading…" : "Refresh")
                </button>
                <button class="btn-primary" @onclick='() => Nav.NavigateTo("/report")'>+ New Report</button>
            </div>
        </div>

        <!-- KPIs -->
        <div class="kpi-grid">
            <div class="kpi-card kpi-critical">
                <div class="kpi-val">@Incidents.Count(i => i.DisplaySeverity == "critical")</div>
                <div class="kpi-lbl">Critical</div>
            </div>
            <div class="kpi-card kpi-high">
                <div class="kpi-val">@Incidents.Count(i => i.DisplaySeverity == "high")</div>
                <div class="kpi-lbl">High</div>
            </div>
            <div class="kpi-card kpi-open">
                <div class="kpi-val">@Incidents.Count(i => i.Status == "open")</div>
                <div class="kpi-lbl">Pending Review</div>
            </div>
            <div class="kpi-card kpi-dispatched">
                <div class="kpi-val">@Incidents.Count(i => i.Status == "accepted")</div>
                <div class="kpi-lbl">Dispatched</div>
            </div>
            <div class="kpi-card kpi-resolved">
                <div class="kpi-val">@Incidents.Count(i => i.Status == "resolved")</div>
                <div class="kpi-lbl">Resolved</div>
            </div>
            <div class="kpi-card kpi-total">
                <div class="kpi-val">@Incidents.Sum(i => i.ReportCount)</div>
                <div class="kpi-lbl">Total Reports</div>
            </div>
        </div>

        <!-- Table -->
        <div class="table-card">
            <div class="table-header">
                <h3>All Incidents</h3>
                <span class="live-badge"><span class="live-dot-blink"></span>Live</span>
            </div>

            @if (IsLoading)
            {
                <div class="state-msg">Loading…</div>
            }
            else if (Incidents.Count == 0)
            {
                <div class="state-msg">No incidents yet.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="inc-table">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Type</th>
                                <th>Severity</th>
                                <th>Location (Lat, Lon)</th>
                                <th>Incident Analysis (AI)</th>
                                <th>Dispatch Units</th>
                                <th>Reports</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var inc in Incidents.OrderByDescending(i => i.LastReportedAt))
                        {
                            var fullText    = !string.IsNullOrEmpty(inc.AnalysisSummary) ? inc.AnalysisSummary : inc.Description;
                            var shortText   = TruncateWords(fullText, 20);
                            var isTruncated = fullText.Length > shortText.Length;

                            <tr class="inc-row @(inc.Status == "resolved" ? "row-resolved" : "")">

                                <!-- Status -->
                                <td>
                                    <span class="status-pill"
                                          style="background:@inc.StatusBg; color:@inc.StatusColor">
                                        @inc.StatusLabel
                                    </span>
                                </td>

                                <!-- Type -->
                                <td>
                                    <div class="field-wrap">
                                        <span class="type-val">@inc.IncidentIcon @inc.DisplayIncidentType</span>
                                        @if (inc.AdminIncidentType != null)
                                        {
                                            <span class="field-hint">edited</span>
                                        }
                                        @if (inc.Status == "open")
                                        {
                                            @if (TypeEditKey == inc.IncidentKey)
                                            {
                                                <!-- Expanded type editor -->
                                                <div class="type-editor">
                                                    <select class="field-select" @bind="TypeEditValue">
                                                        <option value="">— select —</option>
                                                        <option value="fire">🔥 Fire</option>
                                                        <option value="accident">🚗 Accident</option>
                                                        <option value="medical">🚑 Medical</option>
                                                        <option value="crime">🚔 Crime</option>
                                                        <option value="hazard">⚠️ Hazard</option>
                                                         <option value="flood">🌊 Flood</option>
                                                        <option value="earthquake">🏚️ Earthquake</option>
                                                        <option value="riot">👥 Riot</option>
                                                        <option value="explosion">💥 Explosion</option>
                                                        <option value="missing_person">🔍 Missing Person</option>
                                                        <option value="__other__">Other…</option>
                                                    </select>
                                                    @if (TypeEditValue == "__other__")
                                                    {
                                                        <input type="text" class="field-input"
                                                               placeholder="Type name…"
                                                               @bind="TypeEditCustom" />
                                                    }
                                                    <div class="type-editor-btns">
                                                        <button class="btn-mini-confirm" @onclick="() => SaveTypeEdit(inc)">Save</button>
                                                        <button class="btn-mini-cancel"  @onclick="CancelTypeEdit">Cancel</button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <button class="edit-link" @onclick="() => StartTypeEdit(inc)">Change</button>
                                            }
                                        }
                                    </div>
                                </td>

                                <!-- Severity -->
                                <td>
                                    <div class="field-wrap">
                                        <span class="sev-pill"
                                              style="background:@inc.SeverityBg; color:@inc.SeverityColor">
                                            @inc.DisplaySeverity
                                        </span>
                                        @if (inc.AdminSeverity != null)
                                        {
                                            <span class="field-hint" title="AI: @inc.SeverityLevel">edited</span>
                                        }
                                        @if (inc.Status == "open")
                                        {
                                            <select class="field-select"
                                                    @onchange="e => OnSeverityChange(inc, e.Value?.ToString())">
                                                <option value="">— change —</option>
                                                <option value="low">Low</option>
                                                <option value="medium">Medium</option>
                                                <option value="high">High</option>
                                                <option value="critical">Critical</option>
                                            </select>
                                        }
                                    </div>
                                </td>

                                <!-- Location -->
                                <td class="loc-cell">📍 @inc.Location</td>

                                <!-- Analysis -->
                                <td class="desc-cell">
                                    @if (string.IsNullOrEmpty(fullText))
                                    {
                                        <span class="muted">—</span>
                                    }
                                    else if (isTruncated)
                                    {
                                       <div class="tooltip-wrap"
                                            @onmouseenter="e => ShowTooltip(e, fullText)"
                                            @onmouseleave="HideTooltip">
                                            <span class="desc-text">@shortText<span class="muted">…</span></span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="desc-text">@fullText</span>
                                    }
                                </td>

                                <!-- Dispatch units - fully editable -->
                                <td class="dispatch-cell">
                                    @foreach (var unit in inc.DispatchUnits)
                                    {
                                        <span class="unit-tag">
                                            @DispatchIcon(unit) @unit
                                            @if (inc.Status != "resolved")
                                            {
                                                <button class="remove-x"
                                                        @onclick="() => RemoveDispatchUnit(inc, unit)"
                                                        title="Remove">×</button>
                                            }
                                        </span>
                                    }
                                    @if (inc.Status == "open")
                                    {
                                        <button class="edit-units-btn" @onclick="() => OpenAddUnit(inc)">
                                            + Add
                                        </button>
                                    }
                                </td>

                                <!-- Reports (merged: count + last time) -->
                                <td>
                                    <button class="count-btn" @onclick="() => OpenDetail(inc.IncidentKey)">
                                        <span class="count-num">@inc.ReportCount report@(inc.ReportCount != 1 ? "s" : "")</span>
                                        <span class="count-time">@inc.LastReportedAt.ToString("MMM d, HH:mm")</span>
                                    </button>
                                </td>

                                <!-- Actions -->
                                <td class="action-cell">
                                    @if (inc.Status == "open")
                                    {
                                        <button class="confirm-btn" @onclick="() => ConfirmAccept(inc)">
                                            Confirm
                                        </button>
                                    }
                                    else if (inc.Status == "accepted")
                                    {
                                        <div class="dispatched-info">
                                            <span class="dispatched-label">Dispatched</span>
                                            @if (inc.DispatchTriggeredAt.HasValue)
                                            {
                                                <span class="dispatched-time">@inc.DispatchTriggeredAt.Value.ToString("HH:mm")</span>
                                            }
                                            <button class="reopen-btn" @onclick="() => ReopenIncident(inc)" title="Reopen to edit">↩ Reopen</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="dispatched-info">
                                            <span class="resolved-label">Resolved</span>
                                            <button class="reopen-btn" @onclick="() => ReopenIncident(inc)" title="Reopen to edit">↩ Reopen</button>
                                        </div>
                                    }
                                </td>

                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <!-- Floating tooltip rendered at cursor position via Blazor -->
                @if (TooltipVisible)
                {
                    <div style="position:fixed;
                                left:@(TooltipX.ToString("F0"))px;
                                top:@(TooltipY.ToString("F0"))px;
                                transform:translateY(-110%);
                                z-index:99999;
                                background:#1f2937;
                                color:#f3f4f6;
                                font-size:0.8rem;
                                line-height:1.6;
                                padding:0.65rem 0.9rem;
                                border-radius:6px;
                                width:290px;
                                box-shadow:0 8px 24px rgba(0,0,0,0.3);
                                pointer-events:none;
                                white-space:normal;">
                        @TooltipText
                    </div>
                }
            }
        </div>
    </main>
</div>

<!-- ── Detail Drawer ─────────────────────────────────────────────────────── -->
@if (DetailOpen && Detail != null)
{
    <div class="drawer-backdrop" @onclick="CloseDetail">
        <div class="drawer" @onclick:stopPropagation="true">
            <div class="drawer-header">
                <div>
                    <h3>@Detail.IncidentIcon @((Detail.AdminIncidentType ?? Detail.IncidentType).ToUpper()) — Reports</h3>
                    <p class="drawer-sub">@Detail.Location · @Detail.ReportCount report(s)</p>
                </div>
                <button class="close-x" @onclick="CloseDetail">✕</button>
            </div>

            @if (Detail.Status == "accepted")
            {
                <div class="resolve-section">
                    <p class="resolve-desc">All response steps complete? Mark this incident as resolved.</p>
                    <textarea class="resolve-notes" rows="2" placeholder="Optional notes…" @bind="ResolveNotes"></textarea>
                    <button class="resolve-btn" @onclick="() => DoResolve(Detail.IncidentKey)">
                        Mark as Resolved
                    </button>
                </div>
            }
            else if (Detail.Status == "resolved")
            {
                <div class="resolved-banner">
                    Resolved by <strong>@Detail.ResolvedBy</strong>
                    @if (!string.IsNullOrEmpty(Detail.AdminNotes))
                    { <p class="resolved-note-text">@Detail.AdminNotes</p> }
                </div>
            }

            <div class="report-list">
                @foreach (var r in Detail.Reports.OrderByDescending(r => r.SubmittedAt))
                {
                    <div class="report-card @(r.IsDuplicate ? "card-duplicate" : "")">
                        <div class="rc-header">
                            <div class="rc-user">
                                <div class="rc-avatar">@(r.UserName.Length > 0 ? r.UserName[0] : '?')</div>
                                <div>
                                    <div class="rc-name">@r.UserName</div>
                                    <div class="rc-meta">@r.UserEmail · @r.UserRole</div>
                                </div>
                            </div>
                            <div style="display:flex;gap:0.5rem;align-items:center">
                                @if (r.IsDuplicate)
                                {
                                    <span class="dup-badge">Duplicate</span>
                                }
                                <div class="rc-time">@r.SubmittedAt.ToString("MMM d, HH:mm:ss")</div>
                            </div>
                        </div>
                        <div class="rc-body">
                            <span class="rc-type-tag">@r.InputType</span>
                            <p class="rc-desc">@(string.IsNullOrEmpty(r.Description) ? "(No description)" : r.Description)</p>
                            @if (!string.IsNullOrEmpty(r.Location))
                            { <p class="rc-loc">@r.Location</p> }
                            @if (!string.IsNullOrEmpty(r.UploadedImage) && (r.UploadedMimeType?.StartsWith("image") ?? false))
                            {
                                <div class="media-preview">
                                    <img src="data:@r.UploadedMimeType;base64,@r.UploadedImage"
                                         alt="Incident image" class="report-image" />
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(r.UploadedAudio))
                            {
                                <div class="media-preview">
                                    <p class="media-label">🎙 Audio Recording:</p>
                                    <audio controls class="report-audio"
                                           src="data:@(r.UploadedMimeType ?? "audio/wav");base64,@r.UploadedAudio">
                                    </audio>
                                </div>
                            }
                        </div>
                        <!-- Move to existing handled incident — shown on open incident reports only -->
                        @if (!r.IsDuplicate && Detail.Status == "open" && OpenIncidents.Any())
                        {
                            <div class="dup-section">
                                <span class="dup-label">Already handled? Move to:</span>
                                <select class="dup-select"
                                        @onchange="e => OnDuplicateSelect(r.ReportId, e.Value?.ToString())">
                                    <option value="">— select dispatched / resolved incident —</option>
                                    @foreach (var opt in OpenIncidents)
                                    {
                                        <option value="@opt.IncidentKey">
                                            [@opt.Status.ToUpper()] @opt.EffectiveIncidentType — @opt.Location
                                        </option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="rc-id">ID: @r.ReportId</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- ── Confirm Modal ──────────────────────────────────────────────────────── -->
@if (AcceptTarget != null)
{
    <div class="modal-backdrop" @onclick="() => AcceptTarget = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Confirm &amp; Dispatch</h3>
            <p>The following units will be dispatched for this incident:</p>
            <div class="modal-units">
                @foreach (var unit in AcceptTarget.DispatchUnits)
                {
                    <span class="unit-tag">@DispatchIcon(unit) @unit</span>
                }
            </div>
            <div class="modal-meta">
                Type: <strong>@AcceptTarget.DisplayIncidentType</strong>
                &nbsp;·&nbsp;
                Severity: <span class="sev-pill"
                    style="background:@AcceptTarget.SeverityBg; color:@AcceptTarget.SeverityColor">
                    @AcceptTarget.DisplaySeverity
                </span>
            </div>
            <textarea class="modal-notes" rows="2"
                      placeholder="Optional notes for dispatch teams…"
                      @bind="AcceptNotes"></textarea>
            @if (ActionMsg != null)
            {
                <div class="action-msg @(ActionSuccess ? "msg-ok" : "msg-err")">@ActionMsg</div>
            }
            <div class="modal-btns">
                <button class="btn-cancel" @onclick="() => AcceptTarget = null">Cancel</button>
                <button class="btn-confirm" @onclick="DoAccept" disabled="@ActionLoading">
                    @(ActionLoading ? "Confirming…" : "Confirm Dispatch")
                </button>
            </div>
        </div>
    </div>
}

<!-- ── Add Unit Modal ────────────────────────────────────────────────────── -->
@if (AddUnitTarget != null)
{
    <div class="modal-backdrop" @onclick="() => AddUnitTarget = null">
        <div class="modal modal-wide" @onclick:stopPropagation="true">
            <h3>Add Dispatch Unit</h3>
            <p class="section-label">Select a preset:</p>
            <div class="unit-presets">
                @foreach (var preset in AllPresets)
                {
                    var already = AddUnitTarget.DispatchUnits.Contains(preset, StringComparer.OrdinalIgnoreCase);
                    <button class="preset-btn @(already ? "preset-added" : "")" disabled="@already"
                            @onclick="() => AddPresetUnit(preset)">
                        @DispatchIcon(preset) @preset
                    </button>
                }
            </div>
            <p class="section-label">Or type a custom unit:</p>
            <div class="custom-unit-row">
                <input type="text" placeholder="e.g. drone_unit, k9_unit…"
                       @bind="CustomUnitInput" @bind:event="oninput"
                       @onkeydown="OnCustomUnitKey" />
                <button class="btn-add-custom"
                        disabled="@string.IsNullOrWhiteSpace(CustomUnitInput)"
                        @onclick="AddCustomUnit">Add</button>
            </div>
            @if (ActionMsg != null)
            {
                <div class="action-msg @(ActionSuccess ? "msg-ok" : "msg-err")">@ActionMsg</div>
            }
            <div class="modal-btns">
                <button class="btn-cancel" @onclick="() => AddUnitTarget = null">Done</button>
            </div>
        </div>
    </div>
}
}

@code {
    List<AggregatedIncidentSummary> Incidents    = new();
    List<OpenIncidentOption>        OpenIncidents = new();
    AggregatedIncidentDetail?       Detail;
    AggregatedIncidentSummary?      AcceptTarget;
    AggregatedIncidentSummary?      AddUnitTarget;

    bool   IsLoading, DetailOpen, ActionLoading, ActionSuccess;
    string? ActionMsg, AcceptNotes, ResolveNotes, CustomUnitInput;

    // Theme
    bool IsDark = false;
    void ToggleTheme() { IsDark = !IsDark; }

    // Tooltip state
    bool    TooltipVisible;
    double  TooltipX, TooltipY;
    string  TooltipText = string.Empty;

    void ShowTooltip(MouseEventArgs e, string text)
    {
        TooltipVisible = true;
        TooltipX = e.ClientX;
        TooltipY = e.ClientY;
        TooltipText = text;
    }
    void HideTooltip() { TooltipVisible = false; }

    // Type edit state
    string? TypeEditKey;
    string  TypeEditValue  = string.Empty;
    string  TypeEditCustom = string.Empty;

    static readonly string[] AllPresets =
        { "police","traffic_police","ambulance","fire","tow_truck",
          "utility","rescue","coast_guard","bomb_squad","hazmat","k9_unit","drone_unit" };

    string CurrentTime = DateTime.Now.ToString("ddd dd MMM yyyy, HH:mm:ss");
    System.Threading.Timer? _clock;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        if (!Auth.IsAdmin) return;
        _clock = new System.Threading.Timer(_ =>
        {
            CurrentTime = DateTime.Now.ToString("ddd dd MMM yyyy, HH:mm:ss");
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
        await LoadAll();
    }
    public void Dispose() { _clock?.Dispose(); }

    async Task LoadAll()
    {
        IsLoading = true;
        Incidents     = await ReportApi.GetIncidentsAsync("Admin");
        OpenIncidents = await ReportApi.GetOpenIncidentsAsync("Admin");
        IsLoading = false;
    }

    async Task OpenDetail(string key)
    {
        Detail = await ReportApi.GetIncidentDetailAsync(key, "Admin");
        DetailOpen = Detail != null;
    }

    void CloseDetail() { DetailOpen = false; Detail = null; ResolveNotes = null; ActionMsg = null; }
    void Logout()      { Auth.Logout(); Nav.NavigateTo("/login"); }

    void StartTypeEdit(AggregatedIncidentSummary inc)
    {
        TypeEditKey    = inc.IncidentKey;
        TypeEditValue  = inc.AdminIncidentType ?? inc.IncidentType;
        TypeEditCustom = string.Empty;
    }
    void CancelTypeEdit() { TypeEditKey = null; TypeEditValue = string.Empty; TypeEditCustom = string.Empty; }

    async Task SaveTypeEdit(AggregatedIncidentSummary inc)
    {
        var newType = TypeEditValue == "__other__"
            ? TypeEditCustom.Trim().ToLower().Replace(" ", "_")
            : TypeEditValue;
        if (string.IsNullOrEmpty(newType)) return;
        var (ok, _) = await ReportApi.UpdateIncidentAsync(inc.IncidentKey, "Admin",
            new UpdateIncidentRequest { AdminIncidentType = newType });
        if (ok) { CancelTypeEdit(); await LoadAll(); }
    }

    async Task OnSeverityChange(AggregatedIncidentSummary inc, string? val)
    {
        if (string.IsNullOrEmpty(val)) return;
        var (ok, _) = await ReportApi.UpdateIncidentAsync(inc.IncidentKey, "Admin",
            new UpdateIncidentRequest { AdminSeverity = val });
        if (ok) await LoadAll();
    }

    void OpenAddUnit(AggregatedIncidentSummary inc)
    { AddUnitTarget = inc; CustomUnitInput = string.Empty; ActionMsg = null; }

    async Task RemoveDispatchUnit(AggregatedIncidentSummary inc, string unit)
    {
        var newList = inc.DispatchUnits.Where(u => !u.Equals(unit, StringComparison.OrdinalIgnoreCase)).ToList();
        var (ok, _) = await ReportApi.UpdateIncidentAsync(inc.IncidentKey, "Admin",
            new UpdateIncidentRequest { DispatchUnits = newList });
        if (ok) await LoadAll();
    }

    async Task AddPresetUnit(string unit)
    {
        if (AddUnitTarget == null) return;
        var list = AddUnitTarget.DispatchUnits.ToList();
        if (!list.Contains(unit, StringComparer.OrdinalIgnoreCase))
        { list.Add(unit); await SaveUnits(list); }
    }

    async Task AddCustomUnit()
    {
        if (AddUnitTarget == null || string.IsNullOrWhiteSpace(CustomUnitInput)) return;
        var unit = CustomUnitInput.Trim().ToLower().Replace(" ", "_");
        var list = AddUnitTarget.DispatchUnits.ToList();
        if (!list.Contains(unit, StringComparer.OrdinalIgnoreCase))
        { list.Add(unit); await SaveUnits(list); }
        CustomUnitInput = string.Empty;
    }

    async Task OnCustomUnitKey(KeyboardEventArgs e) { if (e.Key == "Enter") await AddCustomUnit(); }

    async Task SaveUnits(List<string> units)
    {
        if (AddUnitTarget == null) return;
        var (ok, msg) = await ReportApi.UpdateIncidentAsync(AddUnitTarget.IncidentKey, "Admin",
            new UpdateIncidentRequest { DispatchUnits = units });
        ActionMsg = ok ? "Saved." : msg; ActionSuccess = ok;
        if (ok) await LoadAll();
        AddUnitTarget = Incidents.FirstOrDefault(i => i.IncidentKey == AddUnitTarget?.IncidentKey);
    }

    async Task ReopenIncident(AggregatedIncidentSummary inc)
    {
        var (ok, _) = await ReportApi.UpdateIncidentAsync(inc.IncidentKey, "Admin",
            new UpdateIncidentRequest { AdminNotes = inc.AdminNotes }); // triggers status reset via dedicated endpoint
        // Call a reopen endpoint — POST to reset status to open
        try {
            var resp = await ReportApi.ReopenIncidentAsync(inc.IncidentKey, "Admin");
            if (resp) await LoadAll();
        } catch { }
    }

    void ConfirmAccept(AggregatedIncidentSummary inc)
    { AcceptTarget = inc; AcceptNotes = null; ActionMsg = null; }

    async Task DoAccept()
    {
        if (AcceptTarget == null) return;
        ActionLoading = true; ActionMsg = null;
        var (ok, msg) = await ReportApi.AcceptIncidentAsync(AcceptTarget.IncidentKey, "Admin",
            new AcceptIncidentRequest { AdminName = Auth.CurrentUser!.Name, Notes = AcceptNotes });
        ActionLoading = false; ActionMsg = msg; ActionSuccess = ok;
        if (ok) { await Task.Delay(800); AcceptTarget = null; await LoadAll(); }
    }

    async Task DoResolve(string key)
    {
        var (ok, msg) = await ReportApi.ResolveIncidentAsync(key, "Admin",
            new ResolveIncidentRequest { AdminName = Auth.CurrentUser!.Name, Notes = ResolveNotes });
        if (ok) { await Task.Delay(600); CloseDetail(); await LoadAll(); }
        else    { ActionMsg = msg; ActionSuccess = false; }
    }

    async Task OnDuplicateSelect(string reportId, string? targetKey)
    {
        if (string.IsNullOrEmpty(targetKey)) return;
        var (ok, msg) = await ReportApi.MarkDuplicateAsync("Admin",
            new MarkDuplicateRequest
            {
                ReportId  = reportId,
                TargetKey = targetKey,
                AdminName = Auth.CurrentUser!.Name
            });
        if (ok && Detail != null)
        {
            Detail = await ReportApi.GetIncidentDetailAsync(Detail.IncidentKey, "Admin");
            await LoadAll();
        }
    }

    static string TruncateWords(string text, int max)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var w = text.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return w.Length <= max ? text : string.Join(" ", w.Take(max));
    }

    static string DispatchIcon(string unit) => unit.ToLower() switch
    {
        "fire"           => "🔥",  "ambulance"      => "🚑",
        "police"         => "🚔",  "traffic_police" => "🚦",
        "tow_truck"      => "🚛",  "utility"        => "⚡",
        "rescue"         => "🛟",  "coast_guard"    => "⛵",
        "bomb_squad"     => "💣",  "hazmat"         => "☢️",
        "k9_unit"        => "🐕",  "drone_unit"     => "🚁",
         "flood_rescue"   => "🌊",  "earthquake_response" => "🏚️",
        "riot_control"   => "👥",  "national_guard" => "🪖",
        _ => "●"
    };
}

