@page "/"
@page "/dashboard"
@using EmergencyPlatform.Frontend.Models
@using EmergencyPlatform.Frontend.Services
@inject AuthService Auth
@inject ReportApiService ReportApi
@inject NavigationManager Nav

<PageTitle>Admin Dashboard — EmergencyAI</PageTitle>

@if (!Auth.IsLoggedIn)
{
    <p>Redirecting...</p>
}
else if (!Auth.IsAdmin)
{
    <div class="no-access">
        <span style="font-size:3rem">🚫</span>
        <h2>Access Denied</h2>
        <p>This page is for administrators only.</p>
        <button class="btn-primary" @onclick='() => Nav.NavigateTo("/report")'>Go to Report Page</button>
    </div>
}
else
{
<div class="dashboard">
    <!-- ── Sidebar ────────────────────────────────────────────────────── -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">🚨</div>
            <div>
                <div class="brand-name">EmergencyAI</div>
                <div class="brand-role">Admin Console</div>
            </div>
        </div>
        <nav class="sidenav">
            <a class="navlink active" href="/dashboard">📊 Dashboard</a>
            <a class="navlink" href="/report">📝 New Report</a>
        </nav>
        <div class="sidebar-bottom">
            <div class="user-chip">
                <div class="avatar">@(Auth.CurrentUser!.Name[0])</div>
                <div>
                    <div class="uname">@Auth.CurrentUser.Name</div>
                    <div class="urole">Administrator</div>
                </div>
            </div>
            <button class="logout-btn" @onclick="Logout">🚪 Logout</button>
        </div>
    </aside>

    <!-- ── Main ──────────────────────────────────────────────────────── -->
    <main class="main-area">
        <div class="topbar">
            <div>
                <h2 class="page-title">Live Incident Dashboard</h2>
                <p class="page-sub">Human-in-loop review · Accept to trigger dispatch · Resolve when done</p>
            </div>
            <div class="topbar-actions">
                <button class="refresh-btn" @onclick="LoadIncidents" disabled="@IsLoading">
                    @(IsLoading ? "⏳" : "🔄") Refresh
                </button>
                <button class="btn-primary" @onclick='() => Nav.NavigateTo("/report")'>+ New Report</button>
            </div>
        </div>

        <!-- ── KPI Cards ──────────────────────────────────────────────── -->
        <div class="kpi-grid">
            <div class="kpi-card" style="--accent:#ff2d55">
                <div class="kpi-val">@Incidents.Count(i => i.DisplaySeverity == "critical")</div>
                <div class="kpi-lbl">Critical</div>
            </div>
            <div class="kpi-card" style="--accent:#ff9500">
                <div class="kpi-val">@Incidents.Count(i => i.DisplaySeverity == "high")</div>
                <div class="kpi-lbl">High</div>
            </div>
            <div class="kpi-card" style="--accent:#ff9500">
                <div class="kpi-val">@Incidents.Count(i => i.Status == "open")</div>
                <div class="kpi-lbl">Open</div>
            </div>
            <div class="kpi-card" style="--accent:#0a84ff">
                <div class="kpi-val">@Incidents.Count(i => i.Status == "accepted")</div>
                <div class="kpi-lbl">Dispatched</div>
            </div>
            <div class="kpi-card" style="--accent:#30d158">
                <div class="kpi-val">@Incidents.Count(i => i.Status == "resolved")</div>
                <div class="kpi-lbl">Resolved</div>
            </div>
            <div class="kpi-card" style="--accent:#636366">
                <div class="kpi-val">@Incidents.Sum(i => i.ReportCount)</div>
                <div class="kpi-lbl">Total Reports</div>
            </div>
        </div>

        <!-- ── Incidents Table ────────────────────────────────────────── -->
        <div class="table-card">
            <div class="table-header">
                <h3>All Incidents</h3>
                <span class="live-dot">● LIVE</span>
            </div>

            @if (IsLoading)
            {
                <div class="loading-state">⏳ Loading incidents...</div>
            }
            else if (Incidents.Count == 0)
            {
                <div class="empty-state">
                    <span style="font-size:3rem">📡</span>
                    <p>No incidents yet. Submit a report to see data here.</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="inc-table">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Type</th>
                                <th>Severity</th>
                                <th>Location</th>
                                <th>Incident Analysis (AI)</th>
                                <th>Dispatch Units</th>
                                <th>Last Reported</th>
                                <th>Reports</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inc in Incidents.OrderByDescending(i => i.LastReportedAt))
                            {
                                var fullText    = !string.IsNullOrEmpty(inc.AnalysisSummary) ? inc.AnalysisSummary : inc.Description;
                                var shortText   = TruncateWords(fullText, 20);
                                var isTruncated = fullText.Length > shortText.Length;

                                <tr class="inc-row @(inc.Status == "resolved" ? "row-resolved" : "")">
                                    <!-- Status -->
                                    <td>
                                        <span class="status-pill" style="background:@(inc.StatusColor)22; color:@inc.StatusColor; border:1px solid @inc.StatusColor">
                                            @inc.StatusIcon @inc.Status.ToUpper()
                                        </span>
                                    </td>

                                    <!-- Type -->
                                    <td><span class="type-badge">@inc.IncidentIcon @inc.IncidentType</span></td>

                                    <!-- Severity with dropdown -->
                                    <td>
                                        <div class="sev-wrap">
                                            <span class="sev-badge"
                                                  style="background:@inc.SeverityColor20; color:@inc.SeverityColor; border:1px solid @inc.SeverityColor">
                                                @inc.DisplaySeverity.ToUpper()
                                            </span>
                                            @if (inc.AdminSeverity != null)
                                            {
                                                <span class="sev-hint" title="AI suggested: @inc.SeverityLevel">✏️ overridden</span>
                                            }
                                            else
                                            {
                                                <span class="sev-hint">🤖 AI</span>
                                            }
                                            @if (inc.Status != "resolved")
                                            {
                                                <select class="sev-select"
                                                        value="@(inc.AdminSeverity ?? inc.SeverityLevel)"
                                                        @onchange="e => OnSeverityChange(inc, e.Value?.ToString())">
                                                    <option value="">-- change --</option>
                                                    <option value="low">Low</option>
                                                    <option value="medium">Medium</option>
                                                    <option value="high">High</option>
                                                    <option value="critical">Critical</option>
                                                </select>
                                            }
                                        </div>
                                    </td>

                                    <!-- Location -->
                                    <td class="loc-cell">📍 @inc.Location</td>

                                    <!-- Analysis -->
                                    <td class="desc-cell">
                                        @if (string.IsNullOrEmpty(fullText))
                                        {
                                            <span class="no-desc">—</span>
                                        }
                                        else if (isTruncated)
                                        {
                                            <div class="tooltip-wrap">
                                                <span class="desc-text">@shortText<span class="ellipsis">…</span></span>
                                                <div class="tooltip-box">@fullText</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="desc-text">@fullText</span>
                                        }
                                    </td>

                                    <!-- Dispatch Units -->
                                    <td class="dispatch-cell">
                                        @foreach (var unit in inc.EffectiveDispatchUnits)
                                        {
                                            <span class="unit-tag">@DispatchIcon(unit) @unit</span>
                                        }
                                        @if (inc.Status != "resolved")
                                        {
                                            <button class="add-unit-btn"
                                                    @onclick="() => OpenAddUnit(inc)">+ Add</button>
                                        }
                                    </td>

                                    <!-- Priority -->
                                    @* <td><span class="priority-tag p@(inc.Priority)">P@(inc.Priority)</span></td> *@

                                    <!-- Time -->
                                    <td class="time-cell">@inc.LastReportedAt.ToString("MMM d, HH:mm")</td>

                                    <!-- Report count -->
                                    <td>
                                        <button class="count-btn" @onclick="() => OpenDetail(inc.IncidentKey)">
                                            @inc.ReportCount report@(inc.ReportCount != 1 ? "s" : "")
                                        </button>
                                    </td>

                                    <!-- Actions -->
                                    <td class="action-cell">
                                        @if (inc.Status == "open")
                                        {
                                            <button class="action-btn accept-btn"
                                                    @onclick="() => ConfirmAccept(inc)">
                                                Confirm
                                            </button>
                                        }
                                        else if (inc.Status == "accepted")
                                        {
                                            <div class="dispatched-info">
                                                <span class="dispatched-label">🚀 Dispatched</span>
                                                @if (inc.DispatchTriggeredAt.HasValue)
                                                {
                                                    <span class="dispatched-time">@inc.DispatchTriggeredAt.Value.ToString("HH:mm")</span>
                                                }
                                            </div>
                                        }
                                        else if (inc.Status == "resolved")
                                        {
                                            <span class="resolved-label">✅ Resolved by @inc.ResolvedBy</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>
</div>

<!-- ── Detail Drawer ─────────────────────────────────────────────────────── -->
@if (DetailOpen && Detail != null)
{
    <div class="drawer-backdrop" @onclick="CloseDetail">
        <div class="drawer" @onclick:stopPropagation="true">
            <div class="drawer-header">
                <div>
                    <h3>@Detail.IncidentIcon @Detail.IncidentType.ToUpper() — All Reports</h3>
                    <p class="drawer-sub">📍 @Detail.Location · @Detail.ReportCount report(s)</p>
                </div>
                <button class="close-x" @onclick="CloseDetail">✕</button>
            </div>

            <!-- Resolve button in drawer -->
            @if (Detail.Status == "accepted")
            {
                <div class="resolve-section">
                    <p class="resolve-desc">Once all emergency response steps are complete and the incident is under control, mark it as resolved.</p>
                    <textarea class="resolve-notes" rows="2"
                              placeholder="Optional resolution notes…"
                              @bind="ResolveNotes"></textarea>
                    <button class="resolve-btn" @onclick="() => DoResolve(Detail.IncidentKey)">
                        🏁 Mark Incident as Resolved
                    </button>
                </div>
            }
            else if (Detail.Status == "resolved")
            {
                <div class="resolved-banner">
                    ✅ Resolved by <strong>@Detail.ResolvedBy</strong>
                    @if (!string.IsNullOrEmpty(Detail.AdminNotes))
                    {
                        <p class="resolved-notes">@Detail.AdminNotes</p>
                    }
                </div>
            }

            <div class="report-list">
                @foreach (var r in Detail.Reports.OrderByDescending(r => r.SubmittedAt))
                {
                    <div class="report-card">
                        <div class="rc-header">
                            <div class="rc-user">
                                <div class="rc-avatar">@(r.UserName.Length > 0 ? r.UserName[0] : '?')</div>
                                <div>
                                    <div class="rc-name">@r.UserName</div>
                                    <div class="rc-email">@r.UserEmail · @r.UserRole</div>
                                </div>
                            </div>
                            <div class="rc-time">@r.SubmittedAt.ToString("MMM d, HH:mm:ss")</div>
                        </div>
                        <div class="rc-body">
                            <span class="rc-type-tag">@r.InputType</span>
                            <p class="rc-desc">@(string.IsNullOrEmpty(r.Description) ? "(No description)" : r.Description)</p>
                            @if (!string.IsNullOrEmpty(r.Location))
                            {
                                <p class="rc-loc">📍 @r.Location</p>
                            }
                        </div>
                        <div class="rc-id">Report ID: @r.ReportId</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- ── Accept Confirm Modal ──────────────────────────────────────────────── -->
@if (AcceptTarget != null)
{
    <div class="modal-backdrop" @onclick="() => AcceptTarget = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Confirm &amp; Dispatch</h3>
            <p>You are about to accept this incident and trigger dispatch for:</p>
            <div class="modal-units">
                @foreach (var unit in AcceptTarget.EffectiveDispatchUnits)
                {
                    <span class="unit-tag large">@DispatchIcon(unit) @unit</span>
                }
            </div>
            <div class="modal-sev">
                Severity: <span class="sev-badge inline"
                    style="background:@AcceptTarget.SeverityColor20; color:@AcceptTarget.SeverityColor; border:1px solid @AcceptTarget.SeverityColor">
                    @AcceptTarget.DisplaySeverity.ToUpper()
                </span>
                @if (AcceptTarget.AdminSeverity != null)
                {
                    <span class="override-note">(AI suggested: @AcceptTarget.SeverityLevel)</span>
                }
            </div>
            <textarea class="modal-notes" rows="2"
                      placeholder="Optional notes for dispatch teams…"
                      @bind="AcceptNotes"></textarea>
            @if (ActionMsg != null)
            {
                <div class="action-msg @(ActionSuccess ? "success" : "error")">@ActionMsg</div>
            }
            <div class="modal-btns">
                <button class="btn-cancel" @onclick="() => AcceptTarget = null">Cancel</button>
                <button class="btn-confirm" @onclick="DoAccept" disabled="@ActionLoading">
                    @if (ActionLoading) { <span class="spinner"></span> }
                    Confirm Dispatch
                </button>
            </div>
        </div>
    </div>
}

<!-- ── Add Unit Modal ────────────────────────────────────────────────────── -->
@if (AddUnitTarget != null)
{
    <div class="modal-backdrop" @onclick="() => AddUnitTarget = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>🚒 Manage Dispatch Units</h3>
            <p>Current units (AI + admin):</p>
            <div class="unit-edit-list">
                @foreach (var unit in AddUnitTarget.EffectiveDispatchUnits)
                {
                    <span class="unit-tag large">@DispatchIcon(unit) @unit</span>
                }
            </div>
            <p style="margin-top:1rem; font-size:0.85rem; color:#374151; font-weight:600;">Add a unit:</p>
            <div class="unit-presets">
                @foreach (var preset in new[] { "police","traffic_police","ambulance","fire","tow_truck","utility","rescue","coast_guard","bomb_squad","hazmat" })
                {
                    var alreadyAdded = AddUnitTarget.EffectiveDispatchUnits
                        .Contains(preset, StringComparer.OrdinalIgnoreCase);
                    <button class="preset-btn @(alreadyAdded ? "added" : "")"
                            disabled="@alreadyAdded"
                            @onclick="() => AddPresetUnit(preset)">
                        @DispatchIcon(preset) @preset
                    </button>
                }
            </div>
            <div class="custom-unit-row">
                <input type="text" placeholder="Or type custom unit name…"
                       @bind="CustomUnitInput" @bind:event="oninput"
                       @onkeydown="OnCustomUnitKey" />
                <button class="btn-add-custom" @onclick="AddCustomUnit"
                        disabled="@string.IsNullOrWhiteSpace(CustomUnitInput)">Add</button>
            </div>
            @if (ActionMsg != null)
            {
                <div class="action-msg @(ActionSuccess ? "success" : "error")">@ActionMsg</div>
            }
            <div class="modal-btns">
                <button class="btn-cancel" @onclick="() => AddUnitTarget = null">Close</button>
            </div>
        </div>
    </div>
}
}

@code {
    List<AggregatedIncidentSummary> Incidents = new();
    AggregatedIncidentDetail? Detail;
    AggregatedIncidentSummary? AcceptTarget;
    AggregatedIncidentSummary? AddUnitTarget;
    bool IsLoading, DetailOpen, ActionLoading, ActionSuccess;
    string? ActionMsg, AcceptNotes, ResolveNotes;
    string CustomUnitInput = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        if (!Auth.IsAdmin) return;
        await LoadIncidents();
    }

    async Task LoadIncidents()
    {
        IsLoading = true;
        Incidents = await ReportApi.GetIncidentsAsync("Admin");
        IsLoading = false;
    }

    async Task OpenDetail(string key)
    {
        Detail = await ReportApi.GetIncidentDetailAsync(key, "Admin");
        DetailOpen = Detail != null;
    }

    void CloseDetail() { DetailOpen = false; Detail = null; ResolveNotes = null; }
    void Logout() { Auth.Logout(); Nav.NavigateTo("/login"); }

    // ── Severity override ─────────────────────────────────────────────────────

    async Task OnSeverityChange(AggregatedIncidentSummary inc, string? newVal)
    {
        if (string.IsNullOrEmpty(newVal)) return;
        var (ok, _) = await ReportApi.UpdateIncidentAsync(inc.IncidentKey, "Admin",
            new UpdateIncidentRequest { AdminSeverity = newVal });
        if (ok) await LoadIncidents();
    }

    // ── Accept & dispatch ─────────────────────────────────────────────────────

    void ConfirmAccept(AggregatedIncidentSummary inc)
    {
        AcceptTarget = inc; AcceptNotes = null; ActionMsg = null;
    }

    async Task DoAccept()
    {
        if (AcceptTarget == null) return;
        ActionLoading = true; ActionMsg = null;
        var (ok, msg) = await ReportApi.AcceptIncidentAsync(AcceptTarget.IncidentKey, "Admin",
            new AcceptIncidentRequest
            {
                AdminName = Auth.CurrentUser!.Name,
                Notes = AcceptNotes
            });
        ActionLoading = false; ActionMsg = msg; ActionSuccess = ok;
        if (ok)
        {
            await Task.Delay(1000);
            AcceptTarget = null;
            await LoadIncidents();
        }
    }

    // ── Resolve ───────────────────────────────────────────────────────────────

    async Task DoResolve(string key)
    {
        var (ok, msg) = await ReportApi.ResolveIncidentAsync(key, "Admin",
            new ResolveIncidentRequest
            {
                AdminName = Auth.CurrentUser!.Name,
                Notes = ResolveNotes
            });
        ActionMsg = msg; ActionSuccess = ok;
        if (ok)
        {
            await Task.Delay(800);
            CloseDetail();
            await LoadIncidents();
        }
    }

    // ── Add unit ──────────────────────────────────────────────────────────────

    void OpenAddUnit(AggregatedIncidentSummary inc)
    {
        AddUnitTarget = inc; CustomUnitInput = string.Empty; ActionMsg = null;
    }

    async Task AddPresetUnit(string unit)
    {
        if (AddUnitTarget == null) return;
        var current = AddUnitTarget.AdminDispatchUnits.ToList();
        if (!current.Contains(unit, StringComparer.OrdinalIgnoreCase))
        {
            current.Add(unit);
            await SaveUnits(current);
        }
    }

    async Task AddCustomUnit()
    {
        if (AddUnitTarget == null || string.IsNullOrWhiteSpace(CustomUnitInput)) return;
        var unit = CustomUnitInput.Trim().ToLower().Replace(" ", "_");
        var current = AddUnitTarget.AdminDispatchUnits.ToList();
        if (!current.Contains(unit, StringComparer.OrdinalIgnoreCase))
        {
            current.Add(unit);
            await SaveUnits(current);
        }
        CustomUnitInput = string.Empty;
    }

    async Task OnCustomUnitKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddCustomUnit();
    }

    async Task SaveUnits(List<string> units)
    {
        if (AddUnitTarget == null) return;
        var (ok, msg) = await ReportApi.UpdateIncidentAsync(AddUnitTarget.IncidentKey, "Admin",
            new UpdateIncidentRequest { AdminDispatchUnits = units });
        ActionMsg = ok ? "Unit added." : msg; ActionSuccess = ok;
        if (ok) await LoadIncidents();
        // Refresh the target reference
        AddUnitTarget = Incidents.FirstOrDefault(i => i.IncidentKey == AddUnitTarget?.IncidentKey);
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    static string TruncateWords(string text, int maxWords)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var words = text.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length <= maxWords ? text : string.Join(" ", words.Take(maxWords));
    }

    static string DispatchIcon(string unit) => unit.ToLower() switch
    {
        "fire"          => "🔥",
        "ambulance"     => "🚑",
        "police"        => "🚔",
        "traffic_police"=> "🚦",
        "tow_truck"     => "🚛",
        "utility"       => "⚡",
        "rescue"        => "🛟",
        "coast_guard"   => "⛵",
        "bomb_squad"    => "💣",
        "hazmat"        => "☢️",
        _               => "🆘"
    };
}

<style>
    .dashboard { display:flex; min-height:100vh; background:#f4f4f8; font-family:-apple-system,sans-serif; }

    /* Sidebar */
    .sidebar { width:220px; background:#111827; color:white; display:flex;
        flex-direction:column; padding:1.5rem 1rem; flex-shrink:0; }
    .brand { display:flex; align-items:center; gap:0.7rem; margin-bottom:2rem; }
    .brand-icon { font-size:1.8rem; }
    .brand-name { font-weight:900; font-size:1rem; }
    .brand-role { font-size:0.68rem; color:#6b7280; }
    .sidenav { display:flex; flex-direction:column; gap:0.3rem; flex:1; }
    .navlink { color:#9ca3af; text-decoration:none; padding:0.55rem 0.75rem;
        border-radius:8px; font-size:0.87rem; transition:all 0.15s; }
    .navlink:hover, .navlink.active { background:rgba(255,255,255,0.08); color:white; }
    .sidebar-bottom { margin-top:auto; display:flex; flex-direction:column; gap:0.6rem; }
    .user-chip { display:flex; align-items:center; gap:0.6rem;
        padding:0.6rem; background:rgba(255,255,255,0.06); border-radius:10px; }
    .avatar { width:32px; height:32px; border-radius:50%; background:#0a84ff;
        display:flex; align-items:center; justify-content:center; font-weight:800; font-size:0.9rem; flex-shrink:0; }
    .uname { font-size:0.82rem; font-weight:700; color:white; }
    .urole { font-size:0.68rem; color:#6b7280; }
    .logout-btn { background:rgba(255,45,85,0.12); border:1px solid rgba(255,45,85,0.25);
        color:#ff6b8a; border-radius:8px; padding:0.45rem 0.75rem; font-size:0.82rem; cursor:pointer; text-align:left; }

    /* Main */
    .main-area { flex:1; overflow-y:auto; }
    .topbar { display:flex; justify-content:space-between; align-items:flex-start;
        padding:1.5rem 2rem 1rem; background:white; border-bottom:1px solid #e5e7eb; }
    .page-title { font-size:1.3rem; font-weight:900; margin:0; color:#111827; }
    .page-sub { color:#9ca3af; font-size:0.82rem; margin:0.2rem 0 0; }
    .topbar-actions { display:flex; gap:0.75rem; align-items:center; }
    .refresh-btn { background:#f3f4f6; border:1px solid #e5e7eb; border-radius:9px; padding:0.5rem 1rem; font-size:0.85rem; cursor:pointer; }
    .btn-primary { background:#0a84ff; color:white; border:none; border-radius:9px; padding:0.55rem 1.1rem; font-weight:700; cursor:pointer; font-size:0.88rem; }

    /* KPIs */
    .kpi-grid { display:flex; gap:1rem; padding:1.5rem 2rem 0; flex-wrap:wrap; }
    .kpi-card { flex:1; min-width:90px; background:white; border-radius:14px; padding:1.1rem;
        text-align:center; border-top:3px solid var(--accent); }
    .kpi-val { font-size:2rem; font-weight:900; color:#111827; }
    .kpi-lbl { font-size:0.72rem; text-transform:uppercase; letter-spacing:0.06em; color:#9ca3af; }

    /* Table */
    .table-card { background:white; border-radius:16px; margin:1.5rem 2rem; overflow:hidden; border:1px solid #e5e7eb; }
    .table-header { display:flex; justify-content:space-between; align-items:center;
        padding:1rem 1.5rem; border-bottom:1px solid #f3f4f6; }
    .table-header h3 { margin:0; font-size:0.97rem; font-weight:700; }
    .live-dot { background:#ff2d55; color:white; font-size:0.7rem; font-weight:700; padding:0.2rem 0.6rem; border-radius:50px; }
    .table-wrap { overflow-x:auto; }
    .inc-table { width:100%; border-collapse:collapse; font-size:0.85rem; }
