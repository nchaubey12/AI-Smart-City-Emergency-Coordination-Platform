<style>
    /* Layout */
    .dashboard { display:flex; min-height:100vh; background:#f4f4f8; font-family:-apple-system,sans-serif; }

    /* Sidebar */
    .sidebar { width:220px; background:#111827; color:white; display:flex;
        flex-direction:column; padding:1.5rem 1rem; flex-shrink:0; }
    .brand { display:flex; align-items:center; gap:0.7rem; margin-bottom:2rem; }
    .brand-icon { font-size:1.8rem; }
    .brand-name { font-weight:900; font-size:1rem; }
    .brand-role { font-size:0.68rem; color:#6b7280; }
    .sidenav { display:flex; flex-direction:column; gap:0.3rem; flex:1; }
    .navlink { color:#9ca3af; text-decoration:none; padding:0.55rem 0.75rem;
        border-radius:8px; font-size:0.87rem; transition:all 0.15s; }
    .navlink:hover, .navlink.active { background:rgba(255,255,255,0.08); color:white; }
    .sidebar-bottom { margin-top:auto; display:flex; flex-direction:column; gap:0.6rem; }
    .user-chip { display:flex; align-items:center; gap:0.6rem;
        padding:0.6rem; background:rgba(255,255,255,0.06); border-radius:10px; }
    .avatar { width:32px; height:32px; border-radius:50%; background:#0a84ff;
        display:flex; align-items:center; justify-content:center;
        font-weight:800; font-size:0.9rem; flex-shrink:0; }
    .uname { font-size:0.82rem; font-weight:700; color:white; }
    .urole { font-size:0.68rem; color:#6b7280; }
    .logout-btn { background:rgba(255,45,85,0.12); border:1px solid rgba(255,45,85,0.25);
        color:#ff6b8a; border-radius:8px; padding:0.45rem 0.75rem;
        font-size:0.82rem; cursor:pointer; text-align:left; }

    /* Main */
    .main-area { flex:1; overflow-y:auto; }
    .topbar { display:flex; justify-content:space-between; align-items:flex-start;
        padding:1.5rem 2rem 1rem; background:white; border-bottom:1px solid #e5e7eb; }
    .page-title { font-size:1.3rem; font-weight:900; margin:0; color:#111827; }
    .page-sub { color:#9ca3af; font-size:0.82rem; margin:0.2rem 0 0; }
    .topbar-actions { display:flex; gap:0.75rem; align-items:center; }
    .refresh-btn { background:#f3f4f6; border:1px solid #e5e7eb; border-radius:9px;
        padding:0.5rem 1rem; font-size:0.85rem; cursor:pointer; }
    .btn-primary { background:#0a84ff; color:white; border:none; border-radius:9px;
        padding:0.55rem 1.1rem; font-weight:700; cursor:pointer; font-size:0.88rem; }

    /* KPIs */
    .kpi-grid { display:flex; gap:1rem; padding:1.5rem 2rem 0; flex-wrap:wrap; }
    .kpi-card { flex:1; min-width:100px; background:white; border-radius:14px;
        padding:1.1rem; text-align:center; border-top:3px solid var(--accent); }
    .kpi-val { font-size:2rem; font-weight:900; color:#111827; }
    .kpi-lbl { font-size:0.72rem; text-transform:uppercase; letter-spacing:0.06em; color:#9ca3af; }

    /* Table */
    .table-card { background:white; border-radius:16px; margin:1.5rem 2rem;
        overflow:hidden; border:1px solid #e5e7eb; }
    .table-header { display:flex; justify-content:space-between; align-items:center;
        padding:1rem 1.5rem; border-bottom:1px solid #f3f4f6; }
    .table-header h3 { margin:0; font-size:0.97rem; font-weight:700; }
    .live-dot { background:#ff2d55; color:white; font-size:0.7rem;
        font-weight:700; padding:0.2rem 0.6rem; border-radius:50px; }
    .table-wrap { overflow-x:auto; }
    .inc-table { width:100%; border-collapse:collapse; font-size:0.87rem; }
    .inc-table th { font-size:0.72rem; text-transform:uppercase; letter-spacing:0.06em;
        color:#9ca3af; text-align:left; padding:0.65rem 1.2rem;
        background:#f9fafb; border-bottom:1px solid #e5e7eb; white-space:nowrap; }
    .inc-row td { padding:0.8rem 1.2rem; border-bottom:1px solid #f3f4f6; vertical-align:middle; }
    .inc-row:hover { background:#f9fafb; }
    .type-badge { font-weight:600; }
    .sev-badge { font-size:0.72rem; font-weight:800; padding:0.25rem 0.6rem;
        border-radius:50px; white-space:nowrap; }
    .loc-cell { color:#374151; max-width:160px; }
    .desc-cell { color:#6b7280; max-width:200px; overflow:hidden;
        text-overflow:ellipsis; white-space:nowrap; }
    .dispatch-cell { color:#374151; font-size:0.82rem; }
    .priority-tag { background:#111827; color:white; font-weight:800; font-size:0.78rem;
        padding:0.2rem 0.5rem; border-radius:6px; }
    .time-cell { color:#9ca3af; white-space:nowrap; font-size:0.82rem; }
    .count-btn { background:#eff6ff; border:1px solid #bfdbfe; color:#1d4ed8;
        border-radius:8px; padding:0.3rem 0.75rem; font-size:0.82rem;
        font-weight:700; cursor:pointer; white-space:nowrap; }
    .count-btn:hover { background:#dbeafe; }

    .loading-state, .empty-state { text-align:center; padding:3rem; color:#9ca3af; }
    .empty-state p { margin:0.5rem 0; }

    /* Drawer */
    .drawer-backdrop { position:fixed; inset:0; background:rgba(0,0,0,0.5);
        z-index:100; display:flex; justify-content:flex-end; }
    .drawer { width:100%; max-width:560px; background:white; height:100%;
        overflow-y:auto; padding:1.5rem; display:flex; flex-direction:column; gap:1rem; }
    .drawer-header { display:flex; justify-content:space-between; align-items:flex-start; }
    .drawer-header h3 { margin:0; font-size:1.05rem; font-weight:800; }
    .drawer-sub { color:#6b7280; font-size:0.82rem; margin:0.2rem 0 0; }
    .close-x { background:#f3f4f6; border:none; border-radius:50%;
        width:32px; height:32px; cursor:pointer; font-size:1rem; flex-shrink:0; }
    .report-list { display:flex; flex-direction:column; gap:0.75rem; }
    .report-card { border:1px solid #e5e7eb; border-radius:12px; padding:1rem; }
    .rc-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem; }
    .rc-user { display:flex; align-items:center; gap:0.6rem; }
    .rc-avatar { width:34px; height:34px; border-radius:50%; background:#0a84ff;
        display:flex; align-items:center; justify-content:center;
        color:white; font-weight:800; font-size:0.9rem; flex-shrink:0; }
    .rc-name { font-weight:700; font-size:0.9rem; }
    .rc-email { font-size:0.75rem; color:#6b7280; }
    .rc-time { font-size:0.75rem; color:#9ca3af; white-space:nowrap; }
    .rc-body { border-top:1px solid #f3f4f6; padding-top:0.75rem; }
    .rc-type-tag { background:#f3f4f6; border-radius:6px; padding:0.15rem 0.5rem;
        font-size:0.72rem; font-weight:700; color:#374151; text-transform:uppercase; }
    .rc-desc { color:#374151; font-size:0.88rem; margin:0.5rem 0 0; line-height:1.5; }
    .rc-loc { color:#6b7280; font-size:0.8rem; margin:0.3rem 0 0; }
    .rc-id { font-size:0.7rem; color:#d1d5db; font-family:monospace; margin-top:0.5rem; }

    /* Access denied */
    .no-access { text-align:center; padding:5rem 2rem; }
    .no-access h2 { font-size:1.5rem; color:#111827; margin:0.5rem 0; }
    .no-access p { color:#6b7280; margin-bottom:1.5rem; }
</style>
